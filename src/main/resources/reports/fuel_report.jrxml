<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Fuel Report" language="groovy" pageWidth="595" pageHeight="842" 
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="logoUrl" class="java.lang.String"/>
    <parameter name="vehicleRegistration" class="java.lang.String"/>
    <parameter name="startDate" class="java.lang.String"/>
    <parameter name="endDate" class="java.lang.String"/>
    <parameter name="totalLiters" class="java.lang.Double"/>
    <parameter name="totalCost" class="java.lang.Double"/>
    <parameter name="avgUnitPrice" class="java.lang.Double"/>
    <parameter name="entryCount" class="java.lang.Integer"/>
    <parameter name="entries" class="java.util.Collection"/>
    <parameter name="reportGenerated" class="java.lang.String"/>

    <queryString>
        <![CDATA[]]>
    </queryString>

    <field name="date" class="java.lang.String"/>
    <field name="station" class="java.lang.String"/>
    <field name="liters" class="java.lang.Double"/>
    <field name="unitPrice" class="java.lang.Double"/>
    <field name="total" class="java.lang.Double"/>
    <field name="odometer" class="java.lang.Double"/>

    <title>
        <band height="140">
            <image>
                <reportElement x="20" y="20" width="60" height="60"/>
                <imageExpression><![CDATA[$P{logoUrl}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="100" y="20" width="400" height="30"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="18" isBold="true" forecolor="#D97706"/>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="55" width="400" height="25"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="14" isBold="true"/>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="85" width="400" height="20"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <textFieldExpression><![CDATA["Vehicle: " + $P{vehicleRegistration} + " | " + $P{startDate} + " to " + $P{endDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="400">
            <!-- Stats Cards -->
            <staticText>
                <reportElement x="20" y="10" width="200" height="20"/>
                <textElement fontName="Arial" fontSize="12" isBold="true" forecolor="#D97706"/>
                <text><![CDATA[Summary Statistics]]></text>
            </staticText>

            <rectangle>
                <reportElement x="20" y="35" width="120" height="60" radius="8"/>
                <graphicElement><pen lineWidth="1" lineColor="#DBEAFE"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="30" y="40" width="100" height="20"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Total Liters]]></text>
            </textField>
            <textField>
                <reportElement x="30" y="60" width="100" height="25"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="16" isBold="true" forecolor="#1E40AF"/>
                <textFieldExpression><![CDATA[$P{totalLiters} + " L"]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="150" y="35" width="120" height="60" radius="8"/>
                <graphicElement><pen lineWidth="1" lineColor="#D1FAE5"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="160" y="40" width="100" height="20"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Total Cost]]></text>
            </textField>
            <textField>
                <reportElement x="160" y="60" width="100" height="25"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="16" isBold="true" forecolor="#065F46"/>
                <textFieldExpression><![CDATA["R " + $P{totalCost}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="280" y="35" width="120" height="60" radius="8"/>
                <graphicElement><pen lineWidth="1" lineColor="#FEF3C7"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="290" y="40" width="100" height="20"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Avg Unit Price]]></text>
            </textField>
            <textField>
                <reportElement x="290" y="60" width="100" height="25"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="16" isBold="true" forecolor="#92400E"/>
                <textFieldExpression><![CDATA["R " + $P{avgUnitPrice}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="410" y="35" width="120" height="60" radius="8"/>
                <graphicElement><pen lineWidth="1" lineColor="#EDE9FE"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="420" y="40" width="100" height="20"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Transactions]]></text>
            </textField>
            <textField>
                <reportElement x="420" y="60" width="100" height="25"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="16" isBold="true" forecolor="#7C3AED"/>
                <textFieldExpression><![CDATA[$P{entryCount}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="20" y="105" width="515" height="1"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E5E7EB"/></graphicElement>
            </line>

            <!-- Table Header -->
            <staticText>
                <reportElement x="20" y="115" width="200" height="20"/>
                <textElement fontName="Arial" fontSize="12" isBold="true" forecolor="#D97706"/>
                <text><![CDATA[Transaction Details]]></text>
            </staticText>

            <!-- Table -->
            <componentElement>
                <reportElement x="20" y="140" width="515" height="200"/>
                <component kind="Table" xmlns="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd">
                    <subreport>
                        <reportElement>
                            <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{entries})]]></dataSourceExpression>
                        </reportElement>
                        <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                    </subreport>
                </component>
            </componentElement>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="20" y="10" width="200" height="15"/>
                <textElement fontName="Arial" fontSize="8" forecolor="#9CA3AF"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{MASTER_CURRENT_PAGE_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="10" width="100" height="15"/>
                <textElement textAlignment="Right" fontName="Arial" fontSize="8" forecolor="#9CA3AF"/>
                <textFieldExpression><![CDATA[$P{reportGenerated}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
