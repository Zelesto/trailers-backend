<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Load Report" language="groovy" pageWidth="595" pageHeight="842" 
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="logoUrl" class="java.lang.String"/>
    <parameter name="loadNumber" class="java.lang.String"/>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="description" class="java.lang.String"/>
    <parameter name="commodityType" class="java.lang.String"/>
    <parameter name="weightKg" class="java.lang.Double"/>
    <parameter name="palletCount" class="java.lang.Integer"/>
    <parameter name="tripCount" class="java.lang.Integer"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="totalDistanceKm" class="java.lang.Double"/>
    <parameter name="totalFromDepotKm" class="java.lang.Double"/>
    <parameter name="totalToDepotKm" class="java.lang.Double"/>
    <parameter name="trips" class="java.util.Collection"/>
    <parameter name="reportGenerated" class="java.lang.String"/>

    <queryString>
        <![CDATA[]]>
    </queryString>

    <field name="tripNumber" class="java.lang.String"/>
    <field name="driverName" class="java.lang.String"/>
    <field name="vehicleRegistration" class="java.lang.String"/>
    <field name="plannedStartDate" class="java.lang.String"/>
    <field name="plannedEndDate" class="java.lang.String"/>
    <field name="actualDistanceKm" class="java.lang.Double"/>
    <field name="status" class="java.lang.String"/>

    <title>
        <band height="120">
            <image>
                <reportElement x="20" y="20" width="60" height="60"/>
                <imageExpression><![CDATA[$P{logoUrl}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="100" y="20" width="400" height="30"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="18" isBold="true"/>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="55" width="400" height="25"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="14" isBold="true"/>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="90" width="135" height="15"/>
                <textElement textAlignment="Right" fontName="Arial" fontSize="8" forecolor="#9CA3AF"/>
                <textFieldExpression><![CDATA["Load #: " + $P{loadNumber}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="400">
            <staticText>
                <reportElement x="20" y="10" width="200" height="20"/>
                <textElement fontName="Arial" fontSize="12" isBold="true" forecolor="#059669"/>
                <text><![CDATA[Load Details]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="35" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Status:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="35" width="350" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
                <textFieldExpression><![CDATA[$P{status}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="60" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Description:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="60" width="350" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
                <textFieldExpression><![CDATA[$P{description}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="85" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Commodity:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="85" width="350" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
                <textFieldExpression><![CDATA[$P{commodityType}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="20" y="115" width="515" height="1"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E5E7EB"/></graphicElement>
            </line>

            <staticText>
                <reportElement x="20" y="125" width="200" height="20"/>
                <textElement fontName="Arial" fontSize="12" isBold="true" forecolor="#059669"/>
                <text><![CDATA[Measurements]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="150" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Weight:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="150" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
                <textFieldExpression><![CDATA[$P{weightKg} + " kg"]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="350" y="150" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Pallets:]]></text>
            </staticText>
            <textField>
                <reportElement x="480" y="150" width="100" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
                <textFieldExpression><![CDATA[$P{palletCount}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="175" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Trips:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="175" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
                <textFieldExpression><![CDATA[$P{tripCount}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="350" y="175" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Customer:]]></text>
            </staticText>
            <textField>
                <reportElement x="480" y="175" width="100" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
                <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="20" y="205" width="515" height="1"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E5E7EB"/></graphicElement>
            </line>

            <staticText>
                <reportElement x="20" y="215" width="200" height="20"/>
                <textElement fontName="Arial" fontSize="12" isBold="true" forecolor="#059669"/>
                <text><![CDATA[Distance Summary]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="240" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[Total Distance:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="240" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#1E40AF"/>
                <textFieldExpression><![CDATA[$P{totalDistanceKm} + " km"]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="350" y="240" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[From Depot:]]></text>
            </staticText>
            <textField>
                <reportElement x="480" y="240" width="100" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#065F46"/>
                <textFieldExpression><![CDATA[$P{totalFromDepotKm} + " km"]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="265" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" forecolor="#6B7280"/>
                <text><![CDATA[To Depot:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="265" width="150" height="20"/>
                <textElement fontName="Arial" fontSize="10" isBold="true" forecolor="#92400E"/>
                <textFieldExpression><![CDATA[$P{totalToDepotKm} + " km"]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="20" y="295" width="515" height="1"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E5E7EB"/></graphicElement>
            </line>

            <!-- Trips Table -->
            <staticText>
                <reportElement x="20" y="305" width="200" height="20"/>
                <textElement fontName="Arial" fontSize="12" isBold="true" forecolor="#059669"/>
                <text><![CDATA[Linked Trips]]></text>
            </staticText>

            <componentElement>
                <reportElement x="20" y="330" width="515" height="60"/>
                <component kind="Table" xmlns="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd">
                    <subreport>
                        <reportElement>
                            <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{trips})]]></dataSourceExpression>
                        </reportElement>
                        <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                    </subreport>
                </component>
            </componentElement>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="20" y="10" width="200" height="15"/>
                <textElement fontName="Arial" fontSize="8" forecolor="#9CA3AF"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{MASTER_CURRENT_PAGE_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="10" width="100" height="15"/>
                <textElement textAlignment="Right" fontName="Arial" fontSize="8" forecolor="#9CA3AF"/>
                <textFieldExpression><![CDATA[$P{reportGenerated}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
