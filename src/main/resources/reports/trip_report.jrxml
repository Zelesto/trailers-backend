<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Trip Report" language="groovy" pageWidth="595" pageHeight="842" 
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Parameters -->
    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="logoUrl" class="java.lang.String"/>
    <parameter name="tripNumber" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="customerCode" class="java.lang.String"/>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="tripType" class="java.lang.String"/>
    <parameter name="referenceNumber" class="java.lang.String"/>
    <parameter name="originLocation" class="java.lang.String"/>
    <parameter name="destinationLocation" class="java.lang.String"/>
    <parameter name="plannedDistanceKm" class="java.lang.Double"/>
    <parameter name="actualDistanceKm" class="java.lang.Double"/>
    <parameter name="driverName" class="java.lang.String"/>
    <parameter name="driverLicense" class="java.lang.String"/>
    <parameter name="vehicleRegistration" class="java.lang.String"/>
    <parameter name="vehicleMake" class="java.lang.String"/>
    <parameter name="vehicleModel" class="java.lang.String"/>
    <parameter name="plannedStartDate" class="java.lang.String"/>
    <parameter name="plannedEndDate" class="java.lang.String"/>
    <parameter name="actualStartDate" class="java.lang.String"/>
    <parameter name="actualEndDate" class="java.lang.String"/>
    <parameter name="actualStartOdometer" class="java.lang.Double"/>
    <parameter name="actualEndOdometer" class="java.lang.Double"/>
    <parameter name="reportGenerated" class="java.lang.String"/>

    <!-- Styles -->
    <style name="Title" isDefault="false" fontName="Arial" fontSize="18" isBold="true"/>
    <style name="Subtitle" isDefault="false" fontName="Arial" fontSize="14" isBold="true"/>
    <style name="SectionHeader" isDefault="false" fontName="Arial" fontSize="12" isBold="true" forecolor="#4F46E5"/>
    <style name="Label" isDefault="false" fontName="Arial" fontSize="10" forecolor="#6B7280"/>
    <style name="Value" isDefault="false" fontName="Arial" fontSize="10" isBold="true" forecolor="#111827"/>
    <style name="Footer" isDefault="false" fontName="Arial" fontSize="8" forecolor="#9CA3AF"/>

    <title>
        <band height="140">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="140" forecolor="#F3F4F6" backcolor="#F9FAFB"/>
            </rectangle>
            
            <!-- Logo -->
            <image>
                <reportElement x="20" y="20" width="60" height="60"/>
                <imageExpression><![CDATA[$P{logoUrl}]]></imageExpression>
            </image>
            
            <!-- Company Name -->
            <textField>
                <reportElement x="100" y="20" width="400" height="30"/>
                <textElement textAlignment="Center" style="Title"/>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            
            <!-- Report Title -->
            <textField>
                <reportElement x="100" y="55" width="400" height="25"/>
                <textElement textAlignment="Center" style="Subtitle"/>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            
            <!-- Trip Number -->
            <textField>
                <reportElement x="400" y="90" width="100" height="20"/>
                <textElement textAlignment="Right" style="Label"/>
                <textFieldExpression><![CDATA["Trip #: " + $P{tripNumber}]]></textFieldExpression>
            </textField>
            
            <!-- Status Badge -->
            <rectangle>
                <reportElement x="20" y="100" width="100" height="25" radius="12">
                    <printWhenExpression><![CDATA[$P{status} != null && !$P{status}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0" lineStyle="Solid"/>
                    <fill>
                        <![CDATA[($P{status}.equals("COMPLETED") || $P{status}.equals("FINALIZED")) ? "#D1FAE5" : ($P{status}.equals("IN_PROGRESS") || $P{status}.equals("ACTIVE")) ? "#DBEAFE" : ($P{status}.equals("PLANNED") || $P{status}.equals("ASSIGNED")) ? "#FEF3C7" : "#F3F4F6"]]>
                    </fill>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="30" y="105" width="80" height="15"/>
                <textElement textAlignment="Center" fontName="Arial" fontSize="10" isBold="true">
                    <![CDATA[($P{status}.equals("COMPLETED") || $P{status}.equals("FINALIZED")) ? "#065F46" : ($P{status}.equals("IN_PROGRESS") || $P{status}.equals("ACTIVE")) ? "#1E40AF" : ($P{status}.equals("PLANNED") || $P{status}.equals("ASSIGNED")) ? "#92400E" : "#6B7280"]]>
                </textElement>
                <textFieldExpression><![CDATA[$P{status} != null ? $P{status} : "N/A"]]></textFieldExpression>
            </textField>
            
            <!-- Generated Date -->
            <textField>
                <reportElement x="400" y="115" width="135" height="15"/>
                <textElement textAlignment="Right" style="Footer"/>
                <textFieldExpression><![CDATA["Generated: " + $P{reportGenerated}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="650">
            <!-- Section: Trip Details -->
            <staticText>
                <reportElement x="20" y="10" width="200" height="20"/>
                <textElement style="SectionHeader"/>
                <text><![CDATA[Trip Details]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="35" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Customer:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="35" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="60" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Customer Code:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="60" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{customerCode}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="85" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Trip Type:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="85" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{tripType}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="110" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Reference:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="110" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{referenceNumber}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="20" y="140" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </graphicElement>
            </line>

            <!-- Section: Route Information -->
            <staticText>
                <reportElement x="20" y="150" width="200" height="20"/>
                <textElement style="SectionHeader"/>
                <text><![CDATA[Route Information]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="175" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Origin:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="175" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{originLocation}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="200" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Destination:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="200" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{destinationLocation}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="225" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Planned Distance:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="225" width="150" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{plannedDistanceKm} + " km"]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="350" y="225" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Actual Distance:]]></text>
            </staticText>
            <textField>
                <reportElement x="480" y="225" width="100" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{actualDistanceKm} + " km"]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="20" y="255" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </graphicElement>
            </line>

            <!-- Section: Driver & Vehicle -->
            <staticText>
                <reportElement x="20" y="265" width="200" height="20"/>
                <textElement style="SectionHeader"/>
                <text><![CDATA[Driver & Vehicle]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="290" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Driver:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="290" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{driverName}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="315" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[License:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="315" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{driverLicense}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="340" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Vehicle:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="340" width="200" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{vehicleRegistration}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="400" y="340" width="100" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Make/Model:]]></text>
            </staticText>
            <textField>
                <reportElement x="480" y="340" width="100" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{vehicleMake} + " " + $P{vehicleModel}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="20" y="370" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </graphicElement>
            </line>

            <!-- Section: Timing -->
            <staticText>
                <reportElement x="20" y="380" width="200" height="20"/>
                <textElement style="SectionHeader"/>
                <text><![CDATA[Timing & Odometer]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="405" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Planned Start:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="405" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{plannedStartDate}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="430" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Actual Start:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="430" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{actualStartDate}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="455" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Planned End:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="455" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{plannedEndDate}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="480" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Actual End:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="480" width="350" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{actualEndDate}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="505" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Odometer Start:]]></text>
            </staticText>
            <textField>
                <reportElement x="180" y="505" width="200" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{actualStartOdometer} + " km"]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="400" y="505" width="150" height="20"/>
                <textElement style="Label"/>
                <text><![CDATA[Odometer End:]]></text>
            </staticText>
            <textField>
                <reportElement x="480" y="505" width="100" height="20"/>
                <textElement style="Value"/>
                <textFieldExpression><![CDATA[$P{actualEndOdometer} + " km"]]></textFieldExpression>
            </textField>

            <!-- Footer -->
            <line>
                <reportElement x="20" y="550" width="515" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E5E7EB"/>
                </graphicElement>
            </line>
            
            <staticText>
                <reportElement x="20" y="560" width="515" height="20"/>
                <textElement textAlignment="Center" style="Footer"/>
                <text><![CDATA[Generated by Trailers System - Confidential]]></text>
            </staticText>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="20" y="10" width="200" height="15"/>
                <textElement style="Footer"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{MASTER_CURRENT_PAGE_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="10" width="100" height="15"/>
                <textElement textAlignment="Right" style="Footer"/>
                <textFieldExpression><![CDATA[$P{reportGenerated}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
